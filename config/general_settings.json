{
  "app": {
    "name": "RAG Assistant",
    "version": "3.0.0",
    "log_level": "INFO",
    "log_file": "logs/app.log",
    "log_max_bytes": 5242880,
    "log_backup_count": 3
  },
  "embedding": {
    "model_name": "all-MiniLM-L6-v2",
    "vector_db_dir": "./OS_base"
  },
  "vector_provider": "chroma",
  "ingestion": {
    "chunk_size": 1000,
    "chunk_overlap": 200,
    "separators": ["\n\n", "\n", ".", " "],
    "uploads_dir": "./uploads",
    "embed_batch_size": 64
  },
  "llm": {
    "provider": "groq",
    "model": "llama-3.1-8b-instant",
    "temperature": 0.1,
    "max_tokens": 1024
  },
  "retrieval": {
    "top_k": 8,
    "history_limit": 6
  },
  "persona": {
    "name": "OS_Helper",
    "role": "expert Operating Systems assistant",
    "tone": "clear, friendly, uses real-world analogies",
    "target_level": "senior high school student"
  }
}